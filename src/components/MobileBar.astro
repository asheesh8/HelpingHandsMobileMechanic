---
import Icon from './Icon.astro';
import { company } from '@/data/business';
---
<div class="mbar" aria-label="Contact Chris">
  <a class="btn" href={`tel:${company.phoneRaw}`}><Icon name="phone" weight="fill" /> Call</a>
  <a class="btn btn--ghost" href={`sms:${company.phoneRaw}`}><Icon name="chat-circle-text" /> Text</a>
</div>

<style>
  .mbar {
    display: none;
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 40;
    gap: var(--s-3);
    padding: 10px var(--gutter) calc(10px + env(safe-area-inset-bottom));
    background: rgb(10 10 11 / 0.86);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-top: 1px solid var(--line);
  }
  .mbar .btn { flex: 1; }
  @media (max-width: 720px) {
    .mbar { display: flex; }
    :global(body) { padding-bottom: calc(72px + env(safe-area-inset-bottom)); }
  }
</style>
