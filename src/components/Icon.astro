---
/**
 * Phosphor icons, inlined at build time from @phosphor-icons/core.
 * Bold weight by default; pass weight="fill" for the filled set.
 * Add a name to the glob below before using it.
 */
export interface Props {
  name: string;
  weight?: 'bold' | 'fill';
  class?: string;
  size?: number;
  label?: string;
}
const { name, weight = 'bold', class: cls, size, label } = Astro.props;

const bold = import.meta.glob(
  '/node_modules/@phosphor-icons/core/assets/bold/{phone,chat-circle-text,arrow-right,arrow-up-right,map-pin,list,x,check,star,wrench,engine,car-profile,battery-charging,drop,gauge,tire,toolbox,hand-heart,graduation-cap,clock,facebook-logo,tiktok-logo,envelope-simple,camera,currency-dollar,shield-check,lightning,house,quotes,plus,caret-down,seal-check,disc,truck,siren}-bold.svg',
  { query: '?raw', import: 'default', eager: true },
) as Record<string, string>;
const fill = import.meta.glob('/node_modules/@phosphor-icons/core/assets/fill/{star,phone,chat-circle-text}-fill.svg', {
  query: '?raw',
  import: 'default',
  eager: true,
}) as Record<string, string>;

const raw =
  weight === 'fill'
    ? fill[`/node_modules/@phosphor-icons/core/assets/fill/${name}-fill.svg`]
    : bold[`/node_modules/@phosphor-icons/core/assets/bold/${name}-bold.svg`];
if (!raw) throw new Error(`Icon "${name}" (${weight}) is not in the Icon.astro glob.`);

const attrs = [
  `class="icon${cls ? ' ' + cls : ''}"`,
  size ? `width="${size}" height="${size}"` : '',
  label ? `role="img" aria-label="${label}"` : 'aria-hidden="true" focusable="false"',
].join(' ');
const svg = raw.replace('<svg ', `<svg ${attrs} fill="currentColor" `);
---
<Fragment set:html={svg} />
