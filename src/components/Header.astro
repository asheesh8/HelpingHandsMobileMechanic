---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { company } from '@/data/business';

const links = [
  { href: '/#services', label: 'Services' },
  { href: '/#brakes', label: 'Brakes' },
  { href: '/#reviews', label: 'Reviews' },
  { href: '/learn/', label: 'Learn it. Fix it.' },
  { href: '/#area', label: 'Service area' },
];
const path = Astro.url.pathname;
---

<header class="hdr" data-hdr>
  <div class="hdr__bar wrap">
    <a class="hdr__brand" href="/" aria-label={`${company.name}, home`}>
      <Logo variant="mark" class="hdr__mark" />
      <span class="hdr__word">
        <span class="hdr__name">Helping Hands</span>
        <span class="hdr__tag">Auto care to your door</span>
      </span>
    </a>

    <nav class="hdr__nav" aria-label="Main">
      <ul>
        {links.map((l) => (
          <li><a href={l.href} aria-current={path === l.href ? 'page' : undefined}>{l.label}</a></li>
        ))}
      </ul>
    </nav>

    <div class="hdr__actions">
      <a class="hdr__phone mono" href={`tel:${company.phoneRaw}`}>
        <Icon name="phone" weight="fill" size={16} />
        {company.phone}
      </a>
      <a class="btn btn--sm hdr__cta" href="/#visit">Request a visit</a>
      <button class="hdr__burger" type="button" aria-expanded="false" aria-controls="menu" data-burger>
        <span class="sr-only">Menu</span>
        <span class="hdr__line"></span>
        <span class="hdr__line"></span>
      </button>
    </div>
  </div>

  <div class="menu" id="menu" data-menu hidden>
    <nav aria-label="Mobile">
      <ul>
        {links.map((l, i) => (
          <li style={`--i:${i}`}><a href={l.href} data-close>{l.label}</a></li>
        ))}
      </ul>
    </nav>
    <div class="menu__foot" style={`--i:${links.length}`}>
      <a class="btn" href={`tel:${company.phoneRaw}`}><Icon name="phone" weight="fill" /> Call {company.phone}</a>
      <a class="btn btn--ghost" href={`sms:${company.phoneRaw}`}><Icon name="chat-circle-text" /> Text Chris</a>
    </div>
  </div>
</header>

<style>
  .hdr {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgb(10 10 11 / 0.72);
    backdrop-filter: blur(14px) saturate(1.4);
    -webkit-backdrop-filter: blur(14px) saturate(1.4);
    border-bottom: 1px solid var(--line);
  }
  .hdr__bar {
    height: var(--header-h);
    display: flex;
    align-items: center;
    gap: var(--s-6);
  }
  .hdr__brand {
    display: flex;
    align-items: center;
    gap: var(--s-4);
    text-decoration: none;
    flex: none;
  }
  .hdr__brand :global(.hdr__mark) { width: 64px; height: auto; }
  .hdr__word { display: grid; line-height: 1; }
  .hdr__name {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: var(--t-xl);
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }
  .hdr__tag {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--red-300);
    margin-top: 4px;
  }

  .hdr__nav { margin-left: auto; }
  .hdr__nav ul { display: flex; gap: var(--s-2); list-style: none; }
  .hdr__nav a {
    display: block;
    padding: 8px 12px;
    font-size: var(--t-sm);
    line-height: var(--lh-sm);
    font-weight: 500;
    color: var(--text-muted);
    text-decoration: none;
    border-radius: var(--r-sm);
    transition: color 160ms ease, background-color 160ms ease;
  }
  .hdr__nav a:hover { color: var(--text); background: rgb(255 255 255 / 0.06); }
  .hdr__nav a[aria-current='page'] { color: var(--text); box-shadow: inset 0 -2px 0 var(--red-600); }

  .hdr__actions { display: flex; align-items: center; gap: var(--s-4); }
  .hdr__phone {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: var(--t-sm);
    color: var(--text);
    text-decoration: none;
    white-space: nowrap;
  }
  .hdr__phone :global(svg) { color: var(--red-300); }

  .hdr__burger {
    display: none;
    position: relative;
    width: 44px;
    height: 44px;
    border: 0;
    background: transparent;
    cursor: pointer;
  }
  .hdr__line {
    position: absolute;
    left: 11px;
    width: 22px;
    height: 2px;
    background: var(--text);
    transition: transform 420ms var(--ease-drawer), top 420ms var(--ease-drawer);
  }
  .hdr__line:nth-of-type(1) { top: 17px; }
  .hdr__line:nth-of-type(2) { top: 25px; }
  .hdr__burger[aria-expanded='true'] .hdr__line:nth-of-type(1) { top: 21px; transform: rotate(45deg); }
  .hdr__burger[aria-expanded='true'] .hdr__line:nth-of-type(2) { top: 21px; transform: rotate(-45deg); }

  .menu {
    position: fixed;
    inset: var(--header-h) 0 0 0;
    padding: var(--s-7) var(--gutter) calc(var(--s-7) + env(safe-area-inset-bottom));
    background: rgb(10 10 11 / 0.94);
    backdrop-filter: blur(24px);
    -webkit-backdrop-filter: blur(24px);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    opacity: 0;
    transition: opacity 320ms var(--ease-out);
  }
  .menu.is-open { opacity: 1; }
  .menu ul { list-style: none; display: grid; gap: var(--s-2); }
  .menu a[data-close] {
    display: block;
    padding: 10px 0;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: var(--t-5xl);
    line-height: 1;
    text-transform: uppercase;
    text-decoration: none;
  }
  .menu li,
  .menu__foot {
    opacity: 0;
    transform: translateY(24px);
    transition: opacity 500ms var(--ease-out), transform 600ms var(--ease-drawer);
    transition-delay: calc(80ms + var(--i) * 45ms);
  }
  .menu.is-open li,
  .menu.is-open .menu__foot { opacity: 1; transform: none; }
  .menu__foot { display: grid; gap: var(--s-4); }

  @media (max-width: 1080px) {
    .hdr__nav { display: none; }
    .hdr__actions { margin-left: auto; }
  }
  @media (max-width: 720px) {
    .hdr__phone, .hdr__cta { display: none; }
    .hdr__burger { display: block; }
    .hdr__brand :global(.hdr__mark) { width: 54px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .menu li, .menu__foot { transform: none; transition: opacity 200ms ease; }
  }
</style>

<script>
  const burger = document.querySelector<HTMLButtonElement>('[data-burger]');
  const menu = document.querySelector<HTMLElement>('[data-menu]');
  if (burger && menu) {
    const set = (open: boolean) => {
      burger.setAttribute('aria-expanded', String(open));
      document.body.style.overflow = open ? 'hidden' : '';
      if (open) {
        menu.hidden = false;
        requestAnimationFrame(() => menu.classList.add('is-open'));
      } else {
        menu.classList.remove('is-open');
        setTimeout(() => { if (burger.getAttribute('aria-expanded') === 'false') menu.hidden = true; }, 320);
      }
    };
    burger.addEventListener('click', () => set(burger.getAttribute('aria-expanded') !== 'true'));
    menu.querySelectorAll('[data-close]').forEach((a) => a.addEventListener('click', () => set(false)));
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') set(false); });
  }
</script>
