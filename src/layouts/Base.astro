---
import '@/styles/global.css';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import MobileBar from '@/components/MobileBar.astro';
import { company, services, serviceArea, hours } from '@/data/business';

export interface Props {
  title: string;
  description: string;
  /** Path only, e.g. "/learn/" */
  canonical?: string;
  ogImage?: string;
  noindex?: boolean;
  /** Extra JSON-LD nodes merged into the page graph. */
  schema?: Record<string, unknown>[];
}

const {
  title,
  description,
  canonical = Astro.url.pathname,
  ogImage = '/og-default.jpg',
  noindex = false,
  schema = [],
} = Astro.props;

const site = company.url;
const canonicalUrl = new URL(canonical, site).href;
const ogUrl = new URL(ogImage, site).href;

const business = {
  '@type': 'AutoRepair',
  '@id': `${site}/#business`,
  name: company.name,
  alternateName: company.shortName,
  description: company.shortDescription,
  slogan: company.tagline,
  url: site,
  telephone: company.phoneRaw,
  email: company.email,
  image: `${site}/og-default.jpg`,
  logo: `${site}/icon-512.png`,
  priceRange: '$$',
  founder: { '@type': 'Person', name: company.owner },
  address: {
    '@type': 'PostalAddress',
    postOfficeBoxNumber: '685',
    addressLocality: company.city,
    addressRegion: company.state,
    postalCode: '03748',
    addressCountry: 'US',
  },
  geo: { '@type': 'GeoCoordinates', latitude: company.geo.lat, longitude: company.geo.lng },
  areaServed: serviceArea.map((t) => ({ '@type': 'City', name: `${t.town}, ${t.state}` })),
  openingHoursSpecification: hours.map((h) => ({
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: h.schemaDays,
    opens: h.opens,
    closes: h.closes,
  })),
  sameAs: [company.facebook, company.tiktok],
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Mobile auto repair',
    itemListElement: services
      .filter((s) => !s.comingSoon)
      .map((s) => ({ '@type': 'Offer', itemOffered: { '@type': 'Service', name: s.name } })),
  },
};

const graph = {
  '@context': 'https://schema.org',
  '@graph': [business, { '@type': 'WebSite', '@id': `${site}/#website`, url: site, name: company.name }, ...schema],
};
---

<!doctype html>
<html lang="en-US">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large'} />
    <meta name="theme-color" content="#0a0a0b" />
    <meta name="format-detection" content="telephone=yes" />
    <meta name="geo.region" content="US-NH" />
    <meta name="geo.placename" content="Enfield, New Hampshire" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={company.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogUrl} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preload" href="/models/brake.glb" as="fetch" crossorigin="anonymous" />

    <script type="application/ld+json" set:html={JSON.stringify(graph)} is:inline />
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
  </head>

  <body>
    <a class="skip-link" href="#main">Skip to main content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <MobileBar />

    <script>
      // Scroll reveal. IntersectionObserver only; no scroll listeners.
      const els = document.querySelectorAll<HTMLElement>('[data-reveal]');
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.classList.add('is-in');
                io.unobserve(e.target);
              }
            }
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.12 },
        );
        els.forEach((el) => io.observe(el));
      } else {
        els.forEach((el) => el.classList.add('is-in'));
      }
    </script>
  </body>
</html>
